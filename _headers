/*
  Link: <https://mochify.app/sitemap.xml>; rel="sitemap", <https://mochify.app/.well-known/api-catalog>; rel="api-catalog", <https://mochify.app/.well-known/ai-catalog.json>; rel="ai-catalog", <https://mochify.app/docs>; rel="service-doc"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Demo loops in /videos are versioned by hand: a re-recorded clip gets a new
# filename, so a long immutable TTL is safe and stops repeat visits re-fetching
# them. Poster frames sit alongside and follow the same rule.
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Comparison stills in /img follow the same hand-versioned rule as /videos: a
# regenerated image gets a new filename rather than being replaced in place,
# because these responses stay immutable for a year in any client that saw them.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# The AI Catalog is prerendered, so Pages serves it from disk and types it by
# extension as application/json, discarding the Content-Type the route sets.
# The Server Card extension says the document SHOULD be served as
# application/ai-catalog+json, so set it here where it actually takes effect.
/.well-known/ai-catalog.json
  Content-Type: application/ai-catalog+json
  Cache-Control: public, max-age=3600

# Social cards are regenerated in place (`bun run og` keeps the filename), so
# they can't be immutable; a day is plenty for crawlers and share previews.
/og/*
  Cache-Control: public, max-age=86400

# Icons keep their filenames across redesigns too, so a week rather than a
# year: a changed icon reaches returning visitors within days.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-96x96.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/web-app-manifest-192x192.png
  Cache-Control: public, max-age=604800
/web-app-manifest-512x512.png
  Cache-Control: public, max-age=604800
